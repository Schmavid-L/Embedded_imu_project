## updated code with ringbuffer that circularly models a trend in data, oscialliting y values, and working with storing psuedo random variables

#define BUFFER_SIZE 10

int ringBuffer[BUFFER_SIZE];





unsigned long lastTime = 0;

const unsigned long interval = 1000;

int head = 0;

int tail = 0;

int count = 1;

int oscCount = 1; 
int direction = 1;

  


unsigned long lastSample = 0;

const unsigned long samplePeriod = 1000;



struct IMUSample { unsigned long time_ms; float ax; float ay; float az; };



void setup() {

Serial.begin(9600);

Serial.println("arduino is running");







}



void loop() {

unsigned long currentTime = millis();

if(currentTime - lastTime >= interval) {

  lastTime = currentTime;

  Serial.println("1 second passed");

}

unsigned long now = millis();

if(now - lastSample >= samplePeriod){ // make it so ax changes every sample

  lastSample = now;

  IMUSample sample;



  sample.time_ms = millis();
  // oscillation logic
  oscCount = oscCount + direction;
  if(oscCount >= 10){
    direction = -1;
  } else if(oscCount <= 1 ){
    direction =1;
  }
  // linear scaling for the oscillation
  sample.ay =((oscCount-1)*(4.0/9.0))-2.0;
  // utilizing the ring buffer to stor the oscillation
  ringBuffer[tail] = oscCount;


  head = (head + 1) % BUFFER_SIZE;
  // noise logic 
  int rando = random(-50,50);
  float noise = rando/100.0;

  //if(direction == 1){
   // noise = 0.2;
 // }else if(direction == -1){
  //  noise = -0.2;
  //}

  sample.ax = 0.1 + count ;


  sample.az = 9.8 + noise;



  Serial.print(sample.time_ms);

 Serial.print(",");

 Serial.print(sample.ax);

 Serial.print(",");

 Serial.print(sample.ay,3);

 Serial.print(",");

  Serial.println(sample.az);

  if (count < 10) {

    count++;

  } else {

    count = 1;

  }

}

}

